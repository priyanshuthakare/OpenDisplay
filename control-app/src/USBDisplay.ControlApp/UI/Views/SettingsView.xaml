<UserControl x:Class="USBDisplay.ControlApp.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="GENERAL" FontWeight="Bold" Margin="0,0,0,6"/>
        <CheckBox Content="Launch at startup (control app)" IsChecked="{Binding Settings.LaunchAtStartup}" Command="{Binding ToggleStartup}"/>
        <CheckBox Content="Minimize to tray instead of closing" IsChecked="{Binding Settings.MinimizeToTray}"/>
        <CheckBox Content="Confirm before stopping" IsChecked="{Binding Settings.ConfirmBeforeStop}"/>
        <CheckBox Content="Confirm before destructive actions" IsChecked="{Binding Settings.ConfirmDestructive}"/>
        <CheckBox Content="Automatically start streaming (only if launch-at-startup is on)" IsChecked="{Binding Settings.AutoStartStreaming}"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="TRANSPORT" FontWeight="Bold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Preferred transport:" Width="150" VerticalAlignment="Center"/>
          <ComboBox Text="{Binding Settings.Transport}" Width="140">
            <ComboBoxItem Content="usb"/>
            <ComboBoxItem Content="wifi"/>
          </ComboBox>
        </StackPanel>
        <TextBlock Text="Native USB bulk: COMING SOON (adb compatibility today)."
                   Foreground="{StaticResource Dim}" Margin="0,4,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Tablet IP / QR JSON:" Width="150" VerticalAlignment="Center"/>
          <TextBox Text="{Binding Settings.DeviceIp, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
        </StackPanel>
        <TextBlock Text="USB port (adb forward):" Margin="0,6,0,0"/>
        <TextBox Text="{Binding Settings.UsbPort}" Width="120" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="CODEC" FontWeight="Bold" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Preferred codec:" Width="150" VerticalAlignment="Center"/>
          <ComboBox Text="{Binding Settings.Codec}" Width="140">
            <ComboBoxItem Content="h264"/>
            <ComboBoxItem Content="h265"/>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Bitrate (bps):" Width="150" VerticalAlignment="Center"/>
          <TextBox Text="{Binding Settings.BitrateBps}" Width="140"/>
          <TextBlock Text="FPS:" Width="60" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBox Text="{Binding Settings.Fps}" Width="70"/>
          <TextBlock Text="GOP:" Width="50" VerticalAlignment="Center" Margin="12,0,0,0"/>
          <TextBox Text="{Binding Settings.Gop}" Width="70"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="ADVANCED — EXECUTABLE PATHS" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="Streamer binary (blank = auto-detect):" Foreground="{StaticResource Dim}"/>
        <TextBox Text="{Binding Settings.StreamerPath, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="ADB binary (blank = auto-detect):" Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>
        <TextBox Text="{Binding Settings.AdbPath, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="Driver scripts dir (blank = auto-detect):" Foreground="{StaticResource Dim}" Margin="0,6,0,0"/>
        <TextBox Text="{Binding Settings.DriverScriptsDir, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="Save Settings" Style="{StaticResource PrimaryButton}" Command="{Binding Save}"
                HorizontalAlignment="Left" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding SavedNote}" Foreground="{StaticResource Accent}"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="FEATURE AVAILABILITY" FontWeight="Bold" Margin="0,0,0,6"/>
        <ListBox ItemsSource="{Binding Features}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding State}" Width="110" Foreground="{StaticResource Dim}"/>
                <TextBlock Text="{Binding Name}" Width="300"/>
                <TextBlock Text="{Binding Note}" Foreground="{StaticResource Dim}" TextWrapping="Wrap"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="ABOUT" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding About}" FontFamily="Consolas" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
