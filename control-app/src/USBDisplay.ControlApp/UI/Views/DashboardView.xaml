<UserControl x:Class="USBDisplay.ControlApp.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:USBDisplay.ControlApp.UI.Views">
  <StackPanel>
    <!-- Status card -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="USB DISPLAY" FontSize="12" Foreground="{StaticResource Dim}"/>
        <TextBlock Text="{Binding StatusText}" FontSize="40" FontWeight="Bold" Margin="0,2,0,8"/>
        <TextBlock Text="{Binding TransportSummary}" Foreground="{StaticResource Dim}" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="START USB DISPLAY" Style="{StaticResource PrimaryButton}"
                  Command="{Binding DataContext.Start, RelativeSource={RelativeSource AncestorType=Window}}"/>
          <Button Content="STOP USB DISPLAY"
                  Command="{Binding DataContext.Stop, RelativeSource={RelativeSource AncestorType=Window}}"/>
          <Button Content="RESTART"
                  Command="{Binding DataContext.Restart, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Transport selector: always visible, explicit switch, never automatic -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="TRANSPORT" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding UsbStatus}" Margin="0,2"/>
        <TextBlock Text="{Binding WifiStatus}" Margin="0,2"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Preferred:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <ComboBox Text="{Binding Settings.Transport}" Width="120">
            <ComboBoxItem Content="usb"/>
            <ComboBoxItem Content="wifi"/>
          </ComboBox>
          <Button Content="USE USB" Command="{Binding SwitchToUsb}" Margin="16,0,0,0"/>
          <Button Content="USE WI-FI" Command="{Binding SwitchToWifi}"/>
          <Button Content="CONNECT USB" Style="{StaticResource PrimaryButton}" Command="{Binding StartUsb}" Margin="16,0,0,0"/>
          <Button Content="START OVER WI-FI" Style="{StaticResource PrimaryButton}" Command="{Binding StartWifi}"/>
        </StackPanel>
        <TextBlock Text="USB and Wi-Fi are equivalent selectable paths. The app never switches automatically."
                   Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>

    <!-- Wi-Fi pairing: dedicated first-class experience -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="WI-FI PAIRING (TLS 1.3 + PIN)" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Device IP / QR JSON:" Width="150" VerticalAlignment="Center"/>
          <TextBox Text="{Binding Settings.DeviceIp, UpdateSourceTrigger=PropertyChanged}" Width="300"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Port:" Width="150" VerticalAlignment="Center"/>
          <TextBox Text="{Binding Settings.WifiPort}" Width="120"/>
          <TextBlock Text="Security: TLS 1.3 (no plaintext fallback)" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding WifiTrust}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="Pairing PIN:" Width="150" VerticalAlignment="Center"/>
          <TextBox Text="{Binding Settings.Pin, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
          <TextBlock Text="{Binding PinNote}" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <Button Content="SHOW PAIRING CODE" Command="{Binding TogglePairingQr}"/>
          <Button Content="FORGET DEVICE" Command="{Binding ForgetTrust}"/>
          <TextBlock Text="{Binding TrustNote}" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Text="PC code payload is {v:1, host_id:host-…} — the tablet scans it (WiFi Pair → Scan PC). Tablet QR is {v:1, ip, port:27184, fp:SHA256:…}."
                   Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <StackPanel Margin="0,8,0,0">
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowPairingQr}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Image Source="{Binding PairingQr}" Width="220" Height="220" HorizontalAlignment="Left"/>
          <TextBlock Text="{Binding PairingQrCaption}" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <TextBlock Text="{Binding ConnectionNote}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock Text="The PIN is supplied to the streamer through its process environment and is not included in the displayed command line. Disk frame capture is disabled; the streaming pipeline must use the in-memory handoff." Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- Error: three layers + actions -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock Text="LAST ERROR" FontSize="12" Foreground="{StaticResource Err}" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding ErrorUser}" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ErrorExplanation}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding ErrorTechnical}" FontFamily="Consolas" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="Use Retry, Run Diagnostics, or View Logs. Transport never changes on its own."
                   Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- Pipeline -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="SIGNAL" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
        <views:SignalMonitor x:Name="Monitor" Height="110"/>
        <TextBlock Text="{Binding NodeHint}" Foreground="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- Telemetry -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="STREAM" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding TelemetryLine}" FontFamily="Consolas" TextWrapping="Wrap"/>
        <TextBlock Text="Latency: N/A (not measured by the pipeline)"
                   Foreground="{StaticResource Dim}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- Recent activity -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="RECENT ACTIVITY" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
        <ItemsControl ItemsSource="{Binding RecentActivity}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontFamily="Consolas" Foreground="{StaticResource Dim}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
