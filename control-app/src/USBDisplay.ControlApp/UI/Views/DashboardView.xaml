<UserControl x:Class="USBDisplay.ControlApp.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:USBDisplay.ControlApp.UI.Views">
  <StackPanel>
    <!-- Status card -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="USB DISPLAY" FontSize="12" Foreground="{StaticResource Dim}"/>
        <TextBlock Text="{Binding StatusText}" FontSize="40" FontWeight="Bold" Margin="0,2,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="START USB DISPLAY" Style="{StaticResource PrimaryButton}"
                  Command="{Binding DataContext.Start, RelativeSource={RelativeSource AncestorType=Window}}"/>
          <Button Content="STOP USB DISPLAY"
                  Command="{Binding DataContext.Stop, RelativeSource={RelativeSource AncestorType=Window}}"/>
          <Button Content="RESTART"
                  Command="{Binding DataContext.Restart, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Pipeline -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="SIGNAL" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
        <views:SignalMonitor x:Name="Monitor" Height="110"/>
      </StackPanel>
    </Border>

    <!-- Telemetry -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="STREAM" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
        <TextBlock Text="{Binding TelemetryLine}" FontFamily="Consolas" TextWrapping="Wrap"/>
        <TextBlock Text="Latency: N/A (not measured by the pipeline)"
                   Foreground="{StaticResource Dim}" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>

    <!-- Recent activity -->
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="RECENT ACTIVITY" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,0,0,6"/>
        <ItemsControl ItemsSource="{Binding RecentActivity}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" FontFamily="Consolas" Foreground="{StaticResource Dim}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
