<UserControl x:Class="USBDisplay.ControlApp.UI.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:USBDisplay.ControlApp.UI.Views">
  <StackPanel>
    <TextBlock Text="Advanced" FontSize="22" FontWeight="Bold" Margin="4,4,0,4"/>
    <TextBlock Text="Display layout, services, logs, diagnostics, and settings."
               Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="4,0,0,8"/>
    <TabControl SelectedIndex="{Binding SelectedIndex}">
      <TabItem Header="Display">
        <views:DisplayView DataContext="{Binding Display}"/>
      </TabItem>
      <TabItem Header="Services">
        <views:ServicesView DataContext="{Binding Services}"/>
      </TabItem>
      <TabItem Header="Logs">
        <views:LogsView DataContext="{Binding Logs}"/>
      </TabItem>
      <TabItem Header="Diagnostics">
        <views:DiagnosticsView DataContext="{Binding Diagnostics}"/>
      </TabItem>
      <TabItem Header="Settings">
        <views:SettingsView DataContext="{Binding Settings}"/>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>
