<UserControl x:Class="USBDisplay.ControlApp.UI.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="USBDisplay Virtual Monitor" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="Topology is read-only here. Use Windows Display Settings to change Extend / Duplicate, resolution, or refresh rate. Changing resolution restarts the capture pipeline."
                   Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,8"/>
        <ListBox ItemsSource="{Binding Displays}" MinHeight="140">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" Width="340" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Status}" Width="80" Foreground="{StaticResource Dim}"/>
                <TextBlock Text="{Binding Width}" FontFamily="Consolas"/>
                <TextBlock Text=" × " Foreground="{StaticResource Dim}"/>
                <TextBlock Text="{Binding Height}" FontFamily="Consolas"/>
                <TextBlock Text="  @  " Foreground="{StaticResource Dim}"/>
                <TextBlock Text="{Binding RefreshHz}" FontFamily="Consolas"/>
                <TextBlock Text=" Hz" Foreground="{StaticResource Dim}"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="Open Windows Display Settings" Command="{Binding OpenSettings}"/>
          <Button Content="Extend Displays" Command="{Binding Extend}"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="CAPTURE STORAGE" FontSize="14" FontWeight="Bold"/>
        <TextBlock Text="{Binding CaptureNote}" TextWrapping="Wrap" Foreground="{StaticResource Dim}" Margin="0,4,0,8"/>
        <Button Content="Purge stale frames" Command="{Binding PurgeCapture}" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
