<UserControl x:Class="USBDisplay.ControlApp.UI.Views.DriverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="USBDisplay Driver" FontSize="18" FontWeight="Bold"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Text="Installation:" Foreground="{StaticResource Dim}"/>
          <TextBlock Grid.Column="1" Text="{Binding Driver.PackageInstalled, FallbackValue='—'}"/>
          <TextBlock Grid.Row="1" Text="Published as:" Foreground="{StaticResource Dim}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Driver.PublishedName, FallbackValue='—'}" FontFamily="Consolas"/>
          <TextBlock Grid.Row="2" Text="Version:" Foreground="{StaticResource Dim}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Driver.DriverVersion, FallbackValue='—'}"/>
          <TextBlock Grid.Row="3" Text="Status:" Foreground="{StaticResource Dim}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Driver.Status, FallbackValue='—'}"/>
          <TextBlock Grid.Row="4" Text="Problem:" Foreground="{StaticResource Dim}"/>
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ProblemMeaning}" TextWrapping="Wrap"/>
          <TextBlock Grid.Row="5" Text="Service:" Foreground="{StaticResource Dim}"/>
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Driver.Service, FallbackValue='—'}"/>
          <TextBlock Grid.Row="6" Text="Virtual display:" Foreground="{StaticResource Dim}"/>
          <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Driver.MonitorPresent, FallbackValue='—'}"/>
          <TextBlock Grid.Row="7" Text="Instance:" Foreground="{StaticResource Dim}"/>
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Driver.InstanceId, FallbackValue='—'}" FontFamily="Consolas" TextWrapping="Wrap"/>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="Refresh" Command="{Binding RefreshDisplay}"/>
          <Button Content="Restart Driver" Command="{Binding Restart}"/>
          <Button Content="Enable" Command="{Binding Enable}"/>
          <Button Content="Disable Driver" Command="{Binding Disable}" Click="Disable_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardBorder}" BorderBrush="{StaticResource Err}">
      <StackPanel>
        <TextBlock Text="DANGER ZONE" Foreground="{StaticResource Err}" FontWeight="Bold"/>
        <TextBlock Text="Uninstall removes the driver package and device node. This is under Settings → Advanced → Driver Management in spirit; it lives here with confirmation."
                   Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,4,0,8"/>
        <Button Content="Uninstall Driver" Style="{StaticResource DangerButton}"
                HorizontalAlignment="Left" Click="Uninstall_Click"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
