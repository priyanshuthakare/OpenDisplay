<UserControl x:Class="USBDisplay.ControlApp.UI.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <Border Style="{StaticResource CardBorder}">
      <StackPanel>
        <TextBlock Text="DIAGNOSTICS" FontSize="18" FontWeight="Bold"/>
        <Button Content="RUN FULL DIAGNOSTIC" Style="{StaticResource PrimaryButton}"
                Command="{Binding Run}" HorizontalAlignment="Left" Margin="0,8,0,8"/>
        <TextBlock Text="{Binding Summary}" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
      </StackPanel>
    </Border>
    <Border Style="{StaticResource CardBorder}">
      <ListBox ItemsSource="{Binding Results}" MinHeight="300">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,4">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Status}" Width="70" FontWeight="Bold"/>
                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
              </StackPanel>
              <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Dim}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Remediation}" Foreground="{StaticResource Warn}" TextWrapping="Wrap"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </StackPanel>
</UserControl>
