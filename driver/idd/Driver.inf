[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer=07/12/2026,0.1.0.0
CatalogFile=USBDisplayIdd.cat
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=USBDisplay,NTamd64

[USBDisplay.NTamd64]
%USBDisplayDeviceName%=USBDisplay_Install, Root\USBDisplayIdd

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
USBDisplayIdd.dll=1

[DestinationDirs]
USBDisplay_CopyFiles=13

[USBDisplay_Install.NT]
CopyFiles=USBDisplay_CopyFiles

[USBDisplay_CopyFiles]
USBDisplayIdd.dll

[USBDisplay_Install.NT.Services]
AddService=WUDFRd,0x000001fa,WUDFRd_ServiceInstall

[WUDFRd_ServiceInstall]
DisplayName=%WUDFRdDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys
LoadOrderGroup=Base

[USBDisplay_Install.NT.Wdf]
UmdfService=USBDisplayIdd,USBDisplay_UmdfService
UmdfServiceOrder=USBDisplayIdd

[USBDisplay_UmdfService]
UmdfLibraryVersion=2.0
ServiceBinary=%13%\USBDisplayIdd.dll
DriverCLSID={B32645F8-DA0B-4D0E-A282-0B1B2E7C041C}

[USBDisplay_Install.NT.HW]
AddReg=USBDisplay_HardwareKeys

[USBDisplay_HardwareKeys]
HKR,,"FriendlyName",0x00000000,"USBDisplay"

[Strings]
ManufacturerName="USBDisplay"
USBDisplayDeviceName="USBDisplay Indirect Display Adapter"
WUDFRdDisplayName="Windows Driver Foundation - User-mode Driver Framework Reflector"
DiskName="USBDisplay Indirect Display Driver Installation Disk"

